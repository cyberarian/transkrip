# Used only when the database has no users. Remove the password after the first successful bootstrap.
TRANSKRIP_ADMIN_USERNAME=admin
TRANSKRIP_ADMIN_DISPLAY_NAME=Administrator
TRANSKRIP_ADMIN_PASSWORD=@admin123456
# TRANSKRIP_HOST=127.0.0.1

# Optional: set a dedicated Python executable for the local DocETL worker.
# Transkrip automatically discovers .venv-analysis on macOS, Linux, and Windows.
# TRANSKRIP_ANALYSIS_PYTHON=/absolute/path/to/python
# TRANSKRIP_ANALYSIS_AUTOSTART=1
